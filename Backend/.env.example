# Buffer Configuration

PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buffer_db?schema=public"

# Auth
JWT_SECRET="supersecret_buffer_key_change_me_in_prod"
JWT_EXPIRES_IN="7d"
SALT_ROUNDS=10

# Interswitch Mock Credentials
INTERSWITCH_CLIENT_ID="mock_client_id_for_sandbox"
INTERSWITCH_CLIENT_SECRET="mock_client_secret_for_sandbox"
\n# Encryption Key for sensitive data (AES-256 must be 32 bytes)\nENCRYPTION_KEY=my_secret_key_needs_32bytes_long
